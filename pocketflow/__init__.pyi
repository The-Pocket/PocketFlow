import asyncio
from typing import Any, Dict, List, Mapping, Optional, Union, TypeVar, Generic

# Type variables for better type relationships
_PrepResult = TypeVar('_PrepResult')
_ExecResult = TypeVar('_ExecResult')
_PostResult = TypeVar('_PostResult')

# More specific parameter types
ParamValue = Union[str, int, float, bool, None, List[Any], Dict[str, Any]]
SharedData = Dict[str, Any]
Params = Dict[str, ParamValue]

# Type variable for the shared data dict. Parameterize it with a TypedDict
# (or a plain dict type) to get stronger type checking inside prep/post.
# Defaults to SharedData so existing code keeps working unchanged.
# The bound is Mapping[str, Any] (not Dict) so that TypedDicts satisfy it.
_SharedDataT = TypeVar('_SharedDataT', bound=Mapping[str, Any], default=SharedData)

class BaseNode(Generic[_PrepResult, _ExecResult, _PostResult, _SharedDataT]):
    params: Params
    successors: Dict[str, BaseNode[Any, Any, Any, _SharedDataT]]

    def __init__(self) -> None: ...
    def set_params(self, params: Params) -> None: ...
    def next(self, node: BaseNode[Any, Any, Any, _SharedDataT], action: str = "default") -> BaseNode[Any, Any, Any, _SharedDataT]: ...
    def prep(self, shared: _SharedDataT) -> _PrepResult: ...
    def exec(self, prep_res: _PrepResult) -> _ExecResult: ...
    def post(self, shared: _SharedDataT, prep_res: _PrepResult, exec_res: _ExecResult) -> _PostResult: ...
    def _exec(self, prep_res: _PrepResult) -> _ExecResult: ...
    def _run(self, shared: _SharedDataT) -> _PostResult: ...
    def run(self, shared: _SharedDataT) -> _PostResult: ...
    def __rshift__(self, other: BaseNode[Any, Any, Any, _SharedDataT]) -> BaseNode[Any, Any, Any, _SharedDataT]: ...
    def __sub__(self, action: str) -> _ConditionalTransition[_SharedDataT]: ...

class _ConditionalTransition(Generic[_SharedDataT]):
    src: BaseNode[Any, Any, Any, _SharedDataT]
    action: str

    def __init__(self, src: BaseNode[Any, Any, Any, _SharedDataT], action: str) -> None: ...
    def __rshift__(self, tgt: BaseNode[Any, Any, Any, _SharedDataT]) -> BaseNode[Any, Any, Any, _SharedDataT]: ...

class Node(BaseNode[_PrepResult, _ExecResult, _PostResult, _SharedDataT]):
    max_retries: int
    wait: Union[int, float]
    cur_retry: int

    def __init__(self, max_retries: int = 1, wait: Union[int, float] = 0) -> None: ...
    def exec_fallback(self, prep_res: _PrepResult, exc: Exception) -> _ExecResult: ...
    def _exec(self, prep_res: _PrepResult) -> _ExecResult: ...

class BatchNode(Node[Optional[List[_PrepResult]], List[_ExecResult], _PostResult, _SharedDataT]):
    def _exec(self, items: Optional[List[_PrepResult]]) -> List[_ExecResult]: ...

class Flow(BaseNode[_PrepResult, Any, _PostResult, _SharedDataT]):
    start_node: Optional[BaseNode[Any, Any, Any, _SharedDataT]]

    def __init__(self, start: Optional[BaseNode[Any, Any, Any, _SharedDataT]] = None) -> None: ...
    def start(self, start: BaseNode[Any, Any, Any, _SharedDataT]) -> BaseNode[Any, Any, Any, _SharedDataT]: ...
    def get_next_node(
        self, curr: BaseNode[Any, Any, Any, _SharedDataT], action: Optional[str]
    ) -> Optional[BaseNode[Any, Any, Any, _SharedDataT]]: ...
    def _orch(
        self, shared: _SharedDataT, params: Optional[Params] = None
    ) -> Any: ...
    def _run(self, shared: _SharedDataT) -> _PostResult: ...
    def post(self, shared: _SharedDataT, prep_res: _PrepResult, exec_res: Any) -> _PostResult: ...

class BatchFlow(Flow[Optional[List[Params]], _PostResult, _SharedDataT]):
    def _run(self, shared: _SharedDataT) -> _PostResult: ...

class AsyncNode(Node[_PrepResult, _ExecResult, _PostResult, _SharedDataT]):
    async def prep_async(self, shared: _SharedDataT) -> _PrepResult: ...
    async def exec_async(self, prep_res: _PrepResult) -> _ExecResult: ...
    async def exec_fallback_async(self, prep_res: _PrepResult, exc: Exception) -> _ExecResult: ...
    async def post_async(
        self, shared: _SharedDataT, prep_res: _PrepResult, exec_res: _ExecResult
    ) -> _PostResult: ...
    # AsyncNode intentionally overrides the sync _exec with an async one
    async def _exec(self, prep_res: _PrepResult) -> _ExecResult: ...  # type: ignore[override]
    async def run_async(self, shared: _SharedDataT) -> _PostResult: ...
    async def _run_async(self, shared: _SharedDataT) -> _PostResult: ...
    def _run(self, shared: _SharedDataT) -> _PostResult: ...

class AsyncBatchNode(AsyncNode[Optional[List[_PrepResult]], List[_ExecResult], _PostResult, _SharedDataT], BatchNode[Optional[List[_PrepResult]], List[_ExecResult], _PostResult, _SharedDataT]):
    async def _exec(self, items: Optional[List[_PrepResult]]) -> List[_ExecResult]: ...  # type: ignore[override]

class AsyncParallelBatchNode(AsyncNode[Optional[List[_PrepResult]], List[_ExecResult], _PostResult, _SharedDataT], BatchNode[Optional[List[_PrepResult]], List[_ExecResult], _PostResult, _SharedDataT]):
    async def _exec(self, items: Optional[List[_PrepResult]]) -> List[_ExecResult]: ...  # type: ignore[override]

class AsyncFlow(Flow[_PrepResult, _PostResult, _SharedDataT], AsyncNode[_PrepResult, Any, _PostResult, _SharedDataT]):
    async def _orch_async(
        self, shared: _SharedDataT, params: Optional[Params] = None
    ) -> Any: ...
    async def _run_async(self, shared: _SharedDataT) -> _PostResult: ...
    async def post_async(
        self, shared: _SharedDataT, prep_res: _PrepResult, exec_res: Any
    ) -> _PostResult: ...

class AsyncBatchFlow(AsyncFlow[Optional[List[Params]], _PostResult, _SharedDataT], BatchFlow[_PostResult, _SharedDataT]):
    async def _run_async(self, shared: _SharedDataT) -> _PostResult: ...

class AsyncParallelBatchFlow(AsyncFlow[Optional[List[Params]], _PostResult, _SharedDataT], BatchFlow[_PostResult, _SharedDataT]):
    async def _run_async(self, shared: _SharedDataT) -> _PostResult: ...
